{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maximus.example/schemas/credits.schema.json",
  "title": "Credits: GET /v1/credits",
  "$comment": "Content attributions for every served title. Fonts are bundled in the app (app/assets/credits/fonts.json, $defs/font_list) so the Credits screen works offline. CONTRACTS.md 2.8.",
  "type": "object",
  "additionalProperties": false,
  "required": ["generated_at", "notices", "text_sources", "images"],
  "properties": {
    "generated_at": { "$ref": "common.schema.json#/$defs/datetime" },
    "notices": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 400 }
    },
    "text_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title_id", "title_name", "name", "url", "license"],
        "properties": {
          "title_id": { "$ref": "common.schema.json#/$defs/slug" },
          "title_name": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "license": { "type": "string", "minLength": 1 }
        }
      }
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "image_id", "title_id", "title_name", "credit_line", "license",
          "license_url", "source_page_url", "modified"
        ],
        "properties": {
          "image_id": { "$ref": "common.schema.json#/$defs/image_id" },
          "title_id": { "$ref": "common.schema.json#/$defs/slug" },
          "title_name": { "type": "string", "minLength": 1 },
          "credit_line": { "type": "string", "minLength": 1 },
          "license": { "$ref": "common.schema.json#/$defs/license" },
          "license_url": { "type": ["string", "null"], "format": "uri" },
          "source_page_url": { "type": ["string", "null"], "format": "uri" },
          "modified": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "font": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "designer", "weights", "license", "license_url", "source_url", "license_asset"],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "designer": { "type": "string", "minLength": 1 },
        "weights": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 100, "maximum": 900 } },
        "license": { "const": "OFL-1.1" },
        "license_url": { "type": "string", "format": "uri" },
        "source_url": { "type": "string", "format": "uri" },
        "license_asset": { "type": "string", "pattern": "^assets/fonts/.+/OFL\\.txt$" }
      }
    },
    "font_list": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fonts"],
      "properties": {
        "fonts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/font" } }
      }
    }
  }
}
