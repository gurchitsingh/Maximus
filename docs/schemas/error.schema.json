{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maximus.example/schemas/error.schema.json",
  "title": "Error body for every non-2xx response (except 304, which has no body)",
  "$comment": "CONTRACTS.md 3.5 and 14.4. message is for logs and developers; the app maps code to its own copy.",
  "type": "object",
  "additionalProperties": false,
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retry_after_s", "details"],
      "properties": {
        "code": {
          "enum": [
            "bad_request",
            "validation_error",
            "not_found",
            "title_not_found",
            "rate_limited",
            "chat_daily_cap",
            "chat_resting",
            "upstream_unavailable",
            "internal_error",
            "unauthorized",
            "token_expired",
            "token_invalid",
            "token_reused",
            "invalid_credentials",
            "google_token_invalid",
            "email_taken",
            "weak_password",
            "reauth_required"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 300 },
        "retry_after_s": { "type": ["integer", "null"], "minimum": 0 },
        "details": { "type": ["object", "null"] }
      }
    }
  }
}
