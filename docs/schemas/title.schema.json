{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maximus.example/schemas/title.schema.json",
  "title": "TitleDetail: GET /v1/titles/{id}",
  "$comment": "Full title payload. The catalogue item is the same object without the detail fields. See CONTRACTS.md 2.1 to 2.6.",
  "type": "object",
  "allOf": [
    { "$ref": "#/$defs/summary_properties" },
    { "$ref": "#/$defs/detail_properties" },
    { "$ref": "#/$defs/kind_rules" }
  ],
  "required": [
    "id", "kind", "name", "subtitle", "poster_lines", "group", "era", "region",
    "period_start", "period_end", "themes", "bg", "tint", "lettering",
    "poster_image_id", "hero_image_id", "brief", "reading_minutes", "lesson_count",
    "quiz_count", "linked_title_ids", "rank", "status", "content_version", "updated_at",
    "lessons", "images", "quiz", "feed_facts", "person", "sources"
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "summary_properties": {
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/slug" },
        "kind": { "$ref": "common.schema.json#/$defs/kind" },
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "subtitle": { "type": ["string", "null"], "maxLength": 60 },
        "poster_lines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "type": "string", "minLength": 1, "maxLength": 24 }
        },
        "group": { "$ref": "common.schema.json#/$defs/group" },
        "era": { "$ref": "common.schema.json#/$defs/era" },
        "region": { "$ref": "common.schema.json#/$defs/region" },
        "period_start": { "$ref": "common.schema.json#/$defs/year_or_null" },
        "period_end": { "$ref": "common.schema.json#/$defs/year_or_null" },
        "themes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/theme" }
        },
        "bg": { "$ref": "common.schema.json#/$defs/hex_color" },
        "tint": { "$ref": "common.schema.json#/$defs/hex_color" },
        "lettering": { "$ref": "common.schema.json#/$defs/lettering" },
        "poster_image_id": { "$ref": "common.schema.json#/$defs/image_ref" },
        "hero_image_id": { "$ref": "common.schema.json#/$defs/image_ref" },
        "brief": { "type": "string", "minLength": 1, "maxLength": 200 },
        "reading_minutes": { "type": "integer", "minimum": 0 },
        "lesson_count": { "type": "integer", "minimum": 0 },
        "quiz_count": { "type": "integer", "minimum": 0 },
        "linked_title_ids": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/slug" }
        },
        "rank": { "type": "integer", "minimum": 0 },
        "status": { "$ref": "common.schema.json#/$defs/content_status" },
        "content_version": { "type": "integer", "minimum": 1 },
        "updated_at": { "$ref": "common.schema.json#/$defs/datetime" }
      }
    },
    "detail_properties": {
      "properties": {
        "lessons": { "type": "array", "items": { "$ref": "#/$defs/lesson" } },
        "images": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/image" } },
        "quiz": { "type": "array", "maxItems": 80, "items": { "$ref": "#/$defs/quiz_question" } },
        "feed_facts": { "type": "array", "maxItems": 60, "items": { "$ref": "#/$defs/feed_fact" } },
        "person": { "oneOf": [{ "$ref": "#/$defs/person" }, { "type": "null" }] },
        "sources": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/source" } }
      }
    },
    "kind_rules": {
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "topic" } }, "required": ["kind"] },
          "then": { "properties": { "person": { "type": "null" } } },
          "else": { "properties": { "person": { "type": "object" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "leader" } }, "required": ["kind"] },
          "then": { "properties": { "person": { "properties": { "odds_beaten": { "minItems": 1 } } } } }
        },
        {
          "if": { "properties": { "kind": { "const": "thinker" } }, "required": ["kind"] },
          "then": { "properties": { "person": { "properties": { "core_ideas": { "minItems": 1 } } } } }
        }
      ]
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title_id", "index", "heading", "body", "reading_minutes",
        "image_ids", "read_aloud_text", "source_ids"
      ],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/lesson_id" },
        "title_id": { "$ref": "common.schema.json#/$defs/slug" },
        "index": { "type": "integer", "minimum": 1 },
        "heading": { "type": "string", "minLength": 1, "maxLength": 80 },
        "body": {
          "$comment": "Markdown subset, CONTRACTS.md 2.2. Checked line by line by the validator.",
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "reading_minutes": { "type": "integer", "minimum": 1 },
        "image_ids": {
          "$comment": "[0] is the hero shown above the heading. Others are placed by ![](id) lines or appended.",
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/image_id" }
        },
        "read_aloud_text": { "type": ["string", "null"], "maxLength": 8000 },
        "source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/source_id" }
        }
      }
    },
    "quiz_question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title_id", "lesson_id", "prompt", "options", "correct_index",
        "explanation", "difficulty", "status", "review_note"
      ],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/quiz_id" },
        "title_id": { "$ref": "common.schema.json#/$defs/slug" },
        "lesson_id": { "$ref": "common.schema.json#/$defs/lesson_ref" },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 200 },
        "options": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        },
        "correct_index": { "type": "integer", "minimum": 0, "maximum": 3 },
        "explanation": { "type": "string", "minLength": 1, "maxLength": 240 },
        "difficulty": { "enum": ["easy", "medium", "hard"] },
        "status": { "$ref": "common.schema.json#/$defs/item_status" },
        "review_note": { "type": ["string", "null"], "maxLength": 300 }
      }
    },
    "feed_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title_id", "lesson_id", "text", "image_id", "status", "review_note"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/fact_id" },
        "title_id": { "$ref": "common.schema.json#/$defs/slug" },
        "lesson_id": { "$ref": "common.schema.json#/$defs/lesson_ref" },
        "text": {
          "$comment": "At most 40 words and 280 characters.",
          "type": "string",
          "minLength": 1,
          "maxLength": 280,
          "pattern": "^\\s*\\S+(?:\\s+\\S+){0,39}\\s*$"
        },
        "image_id": { "$ref": "common.schema.json#/$defs/image_ref" },
        "status": { "$ref": "common.schema.json#/$defs/item_status" },
        "review_note": { "type": ["string", "null"], "maxLength": 300 }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "source_ids"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 300 },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/source_id" }
        }
      }
    },
    "named_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "text", "source_ids"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "text": { "type": "string", "minLength": 1, "maxLength": 300 },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/source_id" }
        }
      }
    },
    "odds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "year_display", "why_impossible", "outcome", "outcome_kind", "source_ids"],
      "properties": {
        "event": { "type": "string", "minLength": 1, "maxLength": 80 },
        "year_display": { "type": ["string", "null"], "maxLength": 40 },
        "why_impossible": { "type": "string", "minLength": 1, "maxLength": 300 },
        "outcome": { "type": "string", "minLength": 1, "maxLength": 300 },
        "outcome_kind": { "enum": ["won", "survived", "refused_to_surrender", "mixed", "lost"] },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/source_id" }
        }
      }
    },
    "life_date": {
      "type": "object",
      "additionalProperties": false,
      "required": ["year", "display"],
      "properties": {
        "year": { "$ref": "common.schema.json#/$defs/year_or_null" },
        "display": { "type": "string", "minLength": 1, "maxLength": 40 }
      }
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role", "born", "died", "region", "headline", "traits", "changes",
        "odds_beaten", "core_ideas", "use_today", "legend_note"
      ],
      "properties": {
        "role": { "type": "string", "minLength": 1, "maxLength": 80 },
        "born": { "$ref": "#/$defs/life_date" },
        "died": { "oneOf": [{ "$ref": "#/$defs/life_date" }, { "type": "null" }] },
        "region": { "type": "string", "minLength": 1, "maxLength": 80 },
        "headline": { "type": "string", "minLength": 1, "maxLength": 140 },
        "traits": { "type": "array", "minItems": 3, "maxItems": 5, "items": { "$ref": "#/$defs/named_claim" } },
        "changes": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "$ref": "#/$defs/claim" } },
        "odds_beaten": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/odds" } },
        "core_ideas": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/named_claim" } },
        "use_today": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/$defs/claim" } },
        "legend_note": { "type": ["string", "null"], "maxLength": 400 }
      }
    }
  }
}
