# Copy to .env and fill in. Never commit .env. Names only, no keys (CONTRACTS 11).
DATABASE_URL=sqlite:///./maximus.db
# Dev: serve draft titles (the 3 samples). Production: false (published titles only).
SERVE_DRAFTS=true
WIKI_USER_AGENT=MaximusApp/0.1 (https://github.com/gurchitsingh/Maximus)
CORS_ORIGINS=
# Ingest (S11): base URL written into image records; images are copied to backend/media/ (gitignored).
MEDIA_BASE_URL=http://10.0.2.2:8000/media
# Chat (S14, CONTRACTS 4). Names only: put real keys in backend/.env, never here.
# Empty values use the defaults in app/config.py (models, caps 20/200, timeout 12 s, context 24000 chars).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
CHAT_DAILY_CAP=
CHAT_GLOBAL_DAILY_CAP=
CHAT_PROVIDER_TIMEOUT_S=
CHAT_CONTEXT_CHARS=
INSTALL_ID_SALT=
