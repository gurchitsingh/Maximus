# Copy to .env and fill in. Never commit .env. Names only, no secrets (CONTRACTS 11, 14.5).
# Empty values fall back to the defaults in app/config.py. Every name is described in backend/README.md.

# development | production. Production refuses to start without JWT_SECRET, INSTALL_ID_SALT and a Postgres URL.
# Unset on Render (RENDER=true) counts as production.
ENVIRONMENT=development

# --- Database (CONTRACTS 18) ---
# Dev and tests: SQLite. Production: Neon's POOLED connection string with sslmode=require (never commit it).
DATABASE_URL=sqlite:///./maximus.db
# Alembic only: Neon's DIRECT (non-pooled) connection string. Empty = DATABASE_URL.
DATABASE_URL_DIRECT=
DB_POOL_SIZE=

# --- Content ---
# Dev: serve draft titles (the 3 samples). Production: false (published titles only).
SERVE_DRAFTS=true
WIKI_USER_AGENT=MaximusApp/0.1 (https://github.com/gurchitsingh/Maximus)
CORS_ORIGINS=
# Ingest (S11): base URL written into image records; images are copied to backend/media/ (gitignored).
MEDIA_BASE_URL=http://10.0.2.2:8000/media
MEDIA_DIR=
RATE_LIMIT_IP_PER_MIN=

# --- Auth (CONTRACTS 14) ---
# Production: a random string of at least 32 characters. Dev: empty = a random per-process secret.
JWT_SECRET=
# The WEB OAuth client id (also the app's serverClientId). Not a secret.
GOOGLE_CLIENT_ID=
# Base of the links in emails and of the web pages (/privacy, /account/delete), e.g. the Render URL.
APP_BASE_URL=http://127.0.0.1:8000
# Shown on /privacy. Empty = "Contact details are on the app's Google Play listing."
CONTACT_EMAIL=

# --- Email (CONTRACTS 14.5) ---
# console (dev: printed to the server log) | resend | smtp
EMAIL_PROVIDER=console
EMAIL_FROM=
EMAIL_PROVIDER_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=

# --- Chat (S14, CONTRACTS 4 and 16) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
CHAT_ACCOUNT_DAILY_CAP=
CHAT_DAILY_CAP=
CHAT_GLOBAL_DAILY_CAP=
CHAT_RETENTION_DAYS=
CHAT_PROVIDER_TIMEOUT_S=
CHAT_CONTEXT_CHARS=
CHAT_INSTALL_PER_MIN=
CHAT_IP_PER_MIN=
# Production: a random string. Salts the install-id hashes kept for the per-install cap.
INSTALL_ID_SALT=

# --- Sync (CONTRACTS 15) ---
SYNC_TOMBSTONE_DAYS=
SYNC_RECORD_QUOTA=
